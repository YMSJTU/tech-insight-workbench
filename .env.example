DATABASE_URL=sqlite:///./data/workbench.db
WORKBENCH_DATA=./data
# Model calls run through a local ACP agent (for example opencode).
# ACP_COMMAND is the agent executable plus optional arguments.
ACP_COMMAND=opencode acp
# Optional model id exposed by the agent; empty means the agent default.
ACP_MODEL=
# Optional isolated HOME/config directory for the agent (relative to project root).
ACP_HOME=
ACP_TIMEOUT=300
# Optional contact email for Unpaywall OA PDF lookup.
UNPAYWALL_EMAIL=
# At most this many PDF candidates are attempted per paper.
PDF_MAX_CANDIDATES=3
# Page render DPI for figures/tables preserved from PDFs.
PDF_RENDER_DPI=110
WORKBENCH_PORT=8765
